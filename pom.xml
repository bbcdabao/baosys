<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <developers>
    <developer>
      <name>Minghui Bao</name>
      <email>baobao.minghui@gmail.com</email>
    </developer>
  </developers>

  <groupId>szs.baosys</groupId>
  <artifactId>baosys</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <name>BaoSys</name>
  <description>BaoSys multi-module project</description>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.7</version>
    <relativePath /> <!-- lookup parent from repository -->
  </parent>

  <modules>
    <module>baosys-common-api</module>
    <module>baosys-common</module>
    <module>baosys-manager</module>
    <module>baosys-manager-web</module>
  </modules>

  <properties>
    <java.version>17</java.version>
    <maven-antrun-plugin.version>3.1.0</maven-antrun-plugin.version>
    <mybatis-plus.version>3.5.16</mybatis-plus.version>
    <output.directory>${maven.multiModuleProjectDirectory}/out</output.directory>
    <spring-cloud.version>2025.0.1</spring-cloud.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>szs.baosys</groupId>
        <artifactId>baosys-common-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>szs.baosys</groupId>
        <artifactId>baosys-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>szs.baosys</groupId>
        <artifactId>baosys-manager-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        <version>${mybatis-plus.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>${java.version}</release>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/*IntegrationTest.java</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-source-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>${maven-antrun-plugin.version}</version>
        <executions>
          <execution>
            <id>clean-output-directory</id>
            <phase>initialize</phase>
            <inherited>false</inherited>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <delete dir="${output.directory}" quiet="true" />
              </target>
            </configuration>
          </execution>
          <execution>
            <id>copy-application-jar</id>
            <phase>verify</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target xmlns:if="ant:if">
                <condition property="is.application.module">
                  <or>
                    <equals arg1="${project.artifactId}"
                      arg2="baosys-manager-service" />
                    <equals arg1="${project.artifactId}"
                      arg2="baosys-manager-web" />
                  </or>
                </condition>
                <mkdir dir="${output.directory}"
                  if:set="is.application.module" />
                <copy
                  file="${project.build.directory}/${project.build.finalName}.jar"
                  todir="${output.directory}"
                  overwrite="true"
                  if:set="is.application.module" />
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>

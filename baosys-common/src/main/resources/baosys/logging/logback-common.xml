<?xml version="1.0" encoding="UTF-8"?>
<included>
  <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="baosys" />
  <!-- Define patterns before importing defaults and creating appenders. -->
  <property name="LOG_LEVEL_PATTERN" value="${LOG_LEVEL_PATTERN:-%5p [traceId=%X{traceId:-no-trace}]}" />
  <property name="CONSOLE_LOG_CHARSET" value="${CONSOLE_LOG_CHARSET:-UTF-8}" />
  <property name="FILE_LOG_CHARSET" value="${FILE_LOG_CHARSET:-UTF-8}" />
  <include resource="org/springframework/boot/logging/logback/defaults.xml" />
  <!-- Preserve per-application filenames when multiple JVMs share LOG_PATH. -->
  <springProperty name="CONFIGURED_LOG_FILE" source="logging.file.name" defaultValue="${LOG_PATH:-.}/${APP_NAME}.log" />
  <property name="LOG_FILE" value="${CONFIGURED_LOG_FILE}" />
  <property name="LOGBACK_ROLLINGPOLICY_MAX_FILE_SIZE" value="${LOGBACK_ROLLINGPOLICY_MAX_FILE_SIZE:-10MB}" />
  <property name="LOGBACK_ROLLINGPOLICY_MAX_HISTORY" value="${LOGBACK_ROLLINGPOLICY_MAX_HISTORY:-7}" />
  <property name="LOGBACK_ROLLINGPOLICY_TOTAL_SIZE_CAP" value="${LOGBACK_ROLLINGPOLICY_TOTAL_SIZE_CAP:-1GB}" />
  <include resource="org/springframework/boot/logging/logback/console-appender.xml" />
  <include resource="org/springframework/boot/logging/logback/file-appender.xml" />
  <root level="INFO">
    <appender-ref ref="CONSOLE" />
    <appender-ref ref="FILE" />
  </root>
</included>

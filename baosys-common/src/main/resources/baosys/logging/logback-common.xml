<?xml version="1.0" encoding="UTF-8"?>
<included>
  <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="baosys" />
  <!-- Define patterns before importing defaults and creating appenders. -->
  <property name="LOG_LEVEL_PATTERN" value="${LOG_LEVEL_PATTERN:-%5p [traceId=%X{traceId:-no-trace}]}" />
  <property name="CONSOLE_LOG_CHARSET" value="${CONSOLE_LOG_CHARSET:-UTF-8}" />
  <property name="FILE_LOG_CHARSET" value="${FILE_LOG_CHARSET:-UTF-8}" />
  <include resource="org/springframework/boot/logging/logback/defaults.xml" />
  <!-- Preserve per-application filenames when multiple JVMs share LOG_PATH. -->
  <springProperty name="CONFIGURED_LOG_FILE" source="logging.file.name" defaultValue="${LOG_PATH:-.}/${APP_NAME}.log" />
  <property name="LOG_FILE" value="${CONFIGURED_LOG_FILE}" />
  <property name="LOGBACK_ROLLINGPOLICY_MAX_FILE_SIZE" value="${LOGBACK_ROLLINGPOLICY_MAX_FILE_SIZE:-5MB}" />
  <include resource="org/springframework/boot/logging/logback/console-appender.xml" />
  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_FILE}</file>
    <encoder>
      <pattern>${FILE_LOG_PATTERN}</pattern>
      <charset>${FILE_LOG_CHARSET}</charset>
    </encoder>

    <!-- 固定窗口策略：只保留 1~3 共 3 个历史文件，结尾为 .log 彻底关闭压缩 -->
    <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
      <fileNamePattern>${LOG_FILE}.%i.log</fileNamePattern>
      <minIndex>1</minIndex>
      <maxIndex>3</maxIndex>
    </rollingPolicy>

    <!-- 触发条件：单个文件达到 10MB 自动滚动 -->
    <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
      <maxFileSize>${LOGBACK_ROLLINGPOLICY_MAX_FILE_SIZE}</maxFileSize>
    </triggeringPolicy>
  </appender>
  <root level="INFO">
    <appender-ref ref="CONSOLE" />
    <appender-ref ref="FILE" />
  </root>
</included>
